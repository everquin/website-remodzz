---
import { services } from '../data/services';
import { site, serviceArea } from '../data/site';
import { totals } from '../data/projects';
---

<footer class="footer bg-ink">
  <div class="wrap">
    <div class="footer-cta">
      <h2 class="display-l">Let's build<br />the plan <span class="red">first.</span></h2>
      <div class="footer-cta-actions">
        <a href="/contact" class="btn btn-red btn-lg">Start your free estimate <span class="arrow" aria-hidden="true">→</span></a>
        <a href={site.phoneHref} class="btn btn-line btn-lg">{site.phone}</a>
      </div>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo-plate">
          <img src="/images/remodzz-logo.png" alt="REMODzz" width="1000" height="500" loading="lazy" />
        </div>
        <p>{site.legalName} dba REMODzz, formerly {site.formerName}. Remodeling and new home construction for {site.region}.</p>
      </div>

      <div>
        <h3 class="mono">Services</h3>
        <ul>
          {services.map((s) => <li><a href={`/services/${s.slug}`}>{s.shortTitle}</a></li>)}
        </ul>
      </div>

      <div>
        <h3 class="mono">Company</h3>
        <ul>
          <li><a href="/portfolio">Projects ({totals.projects})</a></li>
          <li><a href="/about">Why REMODzz</a></li>
          <li><a href="/about#process">Our process</a></li>
          <li><a href="/service-areas">Service area</a></li>
          <li><a href="/contact">Free estimate</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mono">Contact</h3>
        <ul class="contact-list">
          <li><a href={site.phoneHref} class="big">{site.phone}</a></li>
          <li>Fax {site.fax}</li>
          {site.hours.map((h) => <li>{h.days}: {h.time}</li>)}
          <li class="counties">{serviceArea.filter(c => c.state === 'IL').map(c => c.county.replace(' County', '')).join(' · ')} (IL)<br />
            {serviceArea.filter(c => c.state === 'WI').map(c => c.county.replace(' County', '')).join(' · ')} (WI)</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom mono">
      <span>© {new Date().getFullYear()} {site.legalName} dba REMODzz</span>
      <span>Energy Star Partner · Habitat for Humanity Partner</span>
    </div>
  </div>
</footer>

<style>
  .footer { padding: clamp(72px, 10vw, 120px) 0 32px; }
  .footer-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: clamp(48px, 7vw, 88px);
    border-bottom: 1px solid var(--line-dark);
  }
  .footer-cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: 40px;
    padding: 56px 0;
  }
  .logo-plate {
    display: inline-block;
    background: var(--paper);
    padding: 10px 16px 8px;
    border-radius: var(--radius);
    margin-bottom: 20px;
  }
  .logo-plate img { height: 56px; width: auto; }
  .footer-brand p { color: #a19b8f; font-size: 0.95rem; max-width: 36ch; }
  .footer h3 { color: #a19b8f; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; margin-bottom: 16px; }
  .footer ul { display: grid; gap: 8px; }
  .footer ul a { color: var(--paper); transition: color 0.15s; }
  .footer ul a:hover { color: var(--red); }
  .contact-list li { color: #cfc9bd; font-size: 0.95rem; }
  .contact-list .big {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 1.5rem;
  }
  .counties { color: #a19b8f !important; font-size: 0.85rem !important; margin-top: 8px; }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
    color: #7d776c;
    font-size: 0.7rem;
  }
  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>

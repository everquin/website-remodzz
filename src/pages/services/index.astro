---
import Layout from '../../layouts/Layout.astro';
import { services, specialties } from '../../data/services';
import { projectsIn, sheetPhoto } from '../../data/projects';
---

<Layout title="Services" description="Kitchen, bathroom and basement remodeling, home additions, decks and exteriors, new home construction, commercial and handyman services across Northern Illinois and Southern Wisconsin.">
  <section class="page-hero grid-bg">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Services</span></nav>
      <h1 class="display-l">Every room. Every scale.</h1>
      <p class="lead">From a handyman visit to a second-story addition or a new home, every project gets the same in-house design, detailed proposal and guaranteed schedule.</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap svc-grid">
      {services.map((s, i) => {
        const work = projectsIn(s.categories);
        return (
          <a href={`/services/${s.slug}`} class="svc" data-reveal>
            <div class="svc-media">
              <img src={sheetPhoto(s.sheet)} alt="" width="756" height="415" loading={i < 2 ? 'eager' : 'lazy'} />
            </div>
            <div class="svc-body">
              <span class="mono svc-n">{String(i + 1).padStart(2, '0')}</span>
              <h2>{s.title}</h2>
              <p class="svc-tagline">{s.tagline}</p>
              <p class="svc-desc">{s.description}</p>
              <span class="svc-foot mono">
                {work.length ? `${work.length} documented project${work.length > 1 ? 's' : ''}` : 'Details & scope'}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="section bg-ink grid-bg">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Specialties</p>
          <h2 class="display-l">Also in the toolbox.</h2>
        </div>
        <p>Capabilities that run through our projects and are available on their own.</p>
      </div>
      <div class="spec-grid">
        {specialties.map((s, i) => (
          <div class="spec" data-reveal>
            <span class="mono red">S{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .svc {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .svc:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -24px rgba(20, 19, 18, 0.45); }
  .svc-media { aspect-ratio: 756 / 415; overflow: hidden; background: var(--paper-2); }
  .svc-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .svc:hover .svc-media img { transform: scale(1.04); }
  .svc-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 26px 26px;
    border-top: 3px solid var(--ink);
  }
  .svc-n { color: var(--red-ink); }
  .svc h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
  .svc:hover h2 { color: var(--red-ink); }
  .svc-tagline { font-weight: 600; color: var(--ink); }
  .svc-desc { color: var(--muted); font-size: 0.98rem; }
  .svc-foot {
    margin-top: auto;
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--muted);
  }
  .svc-foot span { font-size: 1.1rem; color: var(--ink); transition: transform 0.2s var(--ease); }
  .svc:hover .svc-foot span { transform: translateX(4px); color: var(--red); }

  .spec-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-dark);
  }
  .spec { padding: 28px 28px 8px 0; display: grid; gap: 10px; align-content: start; }
  .spec:not(:last-child) { border-right: 1px solid var(--line-dark); }
  .spec:not(:first-child) { padding-left: 28px; }
  .spec h3 { font-size: 1.5rem; }
  .spec p { color: #a19b8f; }
  @media (max-width: 820px) {
    .svc-grid { grid-template-columns: 1fr; }
    .spec-grid { grid-template-columns: 1fr; }
    .spec { border-right: 0 !important; padding: 24px 0 !important; border-bottom: 1px solid var(--line-dark); }
  }
</style>

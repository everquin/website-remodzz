---
import Layout from '../layouts/Layout.astro';
import TownCheck from '../components/TownCheck.astro';
import { site, serviceArea } from '../data/site';
import { projectsByTown } from '../data/projects';

const states = [
  { code: 'IL', name: 'Illinois' },
  { code: 'WI', name: 'Wisconsin' },
];
const townCount = serviceArea.reduce((n, c) => n + c.towns.length, 0);
---

<Layout title="Service Area" description="REMODzz serves Lake, Cook and McHenry Counties in Illinois and Kenosha, Walworth, Racine and Milwaukee Counties in Wisconsin.">
  <section class="page-hero grid-bg">
    <div class="wrap area-hero">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Service area</span></nav>
        <h1 class="display-l">Local to two states.</h1>
        <p class="lead">{townCount}+ communities across {serviceArea.length} counties, from Lake County to Milwaukee. We know the local codes, the climate and the neighborhoods.</p>
      </div>
      <div class="check-card">
        <TownCheck />
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap">
      <p class="legend mono"><span class="dot"></span> Towns featured in our project gallery. Select one to see the work.</p>
      {states.map((st) => (
        <div class="state">
          <h2 class="state-name"><span class="mono">{st.code}</span>{st.name}</h2>
          <div class="county-grid">
            {serviceArea.filter((c) => c.state === st.code).map((c) => (
              <div class="county">
                <h3>{c.county}</h3>
                <ul>
                  {c.towns.map((t) => (
                    <li>
                      {projectsByTown[t]
                        ? <a href={`/portfolio?town=${encodeURIComponent(t)}`} class="has-work">{t}</a>
                        : <span>{t}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="not-listed">
        <h2 class="display-m">Don't see your town?</h2>
        <p>We may still be able to help. Tell us where the project is.</p>
        <div class="row">
          <a href="/contact" class="btn btn-red">Ask about your location <span class="arrow" aria-hidden="true">→</span></a>
          <a href={site.phoneHref} class="btn btn-line">{site.phone}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .area-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 48px;
    align-items: end;
  }
  .check-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 3px solid var(--red);
    padding: 28px;
  }
  .legend { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 0.7rem; margin-bottom: 40px; }
  .dot { width: 10px; height: 10px; background: var(--red); border-radius: 50%; }
  .state { margin-bottom: 64px; }
  .state-name {
    display: flex;
    align-items: baseline;
    gap: 16px;
    font-size: clamp(2rem, 4vw, 3rem);
    padding-bottom: 16px;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 8px;
  }
  .state-name .mono { color: var(--red); font-size: 0.9rem; }
  .county-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 0 32px;
  }
  .county { padding: 24px 0; }
  .county h3 { font-size: 1.2rem; margin-bottom: 12px; }
  .county ul { display: grid; gap: 2px; }
  .county li { font-size: 0.98rem; color: var(--text); padding: 3px 0; }
  .has-work {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--ink);
  }
  .has-work::before { content: ''; width: 8px; height: 8px; background: var(--red); border-radius: 50%; }
  .has-work:hover { color: var(--red-ink); }
  .not-listed {
    margin-top: 24px;
    padding: clamp(28px, 5vw, 56px);
    background: var(--paper-2);
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .not-listed p { color: var(--muted); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  @media (max-width: 900px) {
    .area-hero { grid-template-columns: 1fr; }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, categoryLabels, type Category } from '../../data/projects';
import { site } from '../../data/site';

const cats = (Object.keys(categoryLabels) as Category[])
  .map((c) => ({ slug: c, label: categoryLabels[c], count: projects.filter((p) => p.categories.includes(c)).length }))
  .filter((c) => c.count > 0);

const towns = [...new Set(projects.map((p) => p.town))].sort();
---

<Layout
  title="Projects"
  description="A selection of REMODzz remodeling and new home projects from across Northern Illinois and Southern Wisconsin: kitchens, baths, basements, additions, decks and new homes."
>
  <section class="page-hero grid-bg">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Projects</span></nav>
      <h1 class="display-l">The project file.</h1>
      <p class="lead">
        A selection from {site.experience.years} years and hundreds of completed projects. Each carries its original job number
        from our NeoTek Construction days and was documented from start to finish.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap">
      <div class="toolbar">
        <div class="filters" role="group" aria-label="Filter by type">
          <button class="chip" aria-pressed="true" data-filter="all">All</button>
          {cats.map((c) => (
            <button class="chip" aria-pressed="false" data-filter={c.slug}>{c.label}</button>
          ))}
        </div>
        <div class="field town-field">
          <label for="townFilter">Town</label>
          <select id="townFilter" class="select">
            <option value="">All towns</option>
            {towns.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
      </div>

      <p class="result mono" aria-live="polite" id="resultCount">Showing all</p>

      <div class="grid" id="projectGrid">
        {projects.map((p, i) => <ProjectCard project={p} eager={i < 3} />)}
      </div>

      <div class="empty" id="emptyState" hidden>
        <p>No projects match that combination yet.</p>
        <button class="btn btn-line btn-sm" id="resetFilters">Show all projects</button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero .lead { max-width: 62ch; }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 2px solid var(--ink);
  }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; flex: 1; }
  .town-field { min-width: 220px; }
  .result { color: var(--muted); font-size: 0.7rem; margin: 20px 0; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  .grid > :global([hidden]) { display: none; }
  .empty { padding: 64px 0; text-align: center; display: grid; justify-items: center; gap: 16px; color: var(--muted); }
  @media (max-width: 640px) {
    .filters { flex-wrap: nowrap; overflow-x: auto; margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter) 4px; scrollbar-width: none; }
    .filters .chip { flex-shrink: 0; }
    .town-field { width: 100%; }
  }
</style>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const townSel = document.getElementById('townFilter') as HTMLSelectElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#projectGrid .pcard'));
  const count = document.getElementById('resultCount')!;
  const empty = document.getElementById('emptyState')!;

  const params = new URLSearchParams(location.search);
  let cat = params.get('type') || 'all';
  let town = params.get('town') || '';
  if (!chips.some((c) => c.dataset.filter === cat)) cat = 'all';
  if (![...townSel.options].some((o) => o.value === town)) town = '';

  const apply = () => {
    let n = 0;
    for (const card of cards) {
      const ok = (cat === 'all' || (card.dataset.categories || '').split(' ').includes(cat)) && (!town || card.dataset.town === town);
      card.hidden = !ok;
      if (ok) n++;
    }
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === cat)));
    townSel.value = town;
    const label = cat === 'all' ? 'all' : (chips.find((c) => c.dataset.filter === cat)?.textContent || '').trim();
    count.textContent = `Showing ${label}${town ? ` in ${town}` : ''}`;
    empty.hidden = n > 0;

    const q = new URLSearchParams();
    if (cat !== 'all') q.set('type', cat);
    if (town) q.set('town', town);
    history.replaceState(null, '', q.toString() ? `?${q}` : location.pathname);
  };

  chips.forEach((c) => c.addEventListener('click', () => { cat = c.dataset.filter!; apply(); }));
  townSel.addEventListener('change', () => { town = townSel.value; apply(); });
  document.getElementById('resetFilters')!.addEventListener('click', () => { cat = 'all'; town = ''; apply(); });
  apply();
</script>

---
import Layout from '../layouts/Layout.astro';
import { site, serviceArea } from '../data/site';

// Estimate requests go to Web3Forms, which emails site.estimateEmail.
// PUBLIC_ESTIMATE_ENDPOINT overrides this with any endpoint that accepts
// FormData (Formspree, a Cloudflare Worker, etc).
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || site.web3formsKey;
const endpoint = import.meta.env.PUBLIC_ESTIMATE_ENDPOINT || (web3formsKey ? 'https://api.web3forms.com/submit' : '');

const types = [
  { value: 'kitchen', label: 'Kitchen' },
  { value: 'bathroom', label: 'Bathroom' },
  { value: 'basement', label: 'Basement' },
  { value: 'addition', label: 'Addition' },
  { value: 'outdoor', label: 'Deck, patio or exterior' },
  { value: 'new-home', label: 'New home' },
  { value: 'theater', label: 'Home theater or den' },
  { value: 'interiors', label: 'Flooring & interiors' },
  { value: 'commercial', label: 'Commercial' },
  { value: 'handyman', label: 'Handyman / repairs' },
  { value: 'design', label: 'Design only' },
  { value: 'other', label: 'Something else' },
];
const scopes = ['Refresh or update', 'Full remodel', 'Addition or new construction', 'Repair or small job', 'Not sure yet'];
const timelines = ['As soon as possible', '1–3 months', '3–6 months', '6+ months', 'Just planning'];
const budgets = ['Under $25k', '$25k–$50k', '$50k–$100k', '$100k+', 'Not sure yet'];
const towns = serviceArea.flatMap((c) => c.towns).sort();

const faqs = [
  { q: 'Is the estimate really free?', a: 'Yes. The consultation and estimate are free and no-hassle. We meet at your home, look at the space and talk through what you want to do.' },
  { q: 'Is design included?', a: 'Yes. In-house design is part of every project: layouts, renderings and 3D views, so the price is accurate and you can see the result before construction.' },
  { q: 'What does the proposal cover?', a: 'Our proposals work through 54+ project categories and spell out what is included, what is an allowance and what is excluded, so there are no surprises later.' },
  { q: 'How do you guarantee the schedule?', a: 'You get a detailed calendar of events, and we put penalties on ourselves if we miss the completion date.' },
  { q: 'What warranty do you offer?', a: 'Two years, across every project type.' },
  { q: 'How can I pay?', a: `We accept ${site.payment.join(', ')}. Payment plans are available. Ask us for details.` },
];
---

<Layout title="Free Estimate" description="Request a free, no-hassle estimate from REMODzz. Tell us about your kitchen, bath, basement, addition or new home project in about two minutes.">
  <section class="page-hero est-hero grid-bg">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Free estimate</span></nav>
      <h1 class="display-l">Tell us what you're <span class="red">planning.</span></h1>
      <p class="lead">Four quick steps, about two minutes. We'll get back to you within one business day to schedule a free consultation.</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap est-grid">
      <div class="est-main">
        <form id="estimate" class="wizard" data-endpoint={endpoint} novalidate>
          {web3formsKey && <input type="hidden" name="access_key" value={web3formsKey} />}
          <input type="hidden" name="from_name" value="REMODzz website" />
          <ol class="progress" aria-hidden="true">
            <li class="is-current"><span>1</span>Project</li>
            <li><span>2</span>Scope</li>
            <li><span>3</span>Details</li>
            <li><span>4</span>Contact</li>
          </ol>

          <fieldset class="step" data-step="1">
            <legend class="step-title"><span class="mono red">Step 1 of 4</span>What are we working on?</legend>
            <p class="hint">Choose all that apply.</p>
            <div class="type-grid">
              {types.map((t) => (
                <label class="type">
                  <input type="checkbox" name="project_type" value={t.label} data-key={t.value} />
                  <span>{t.label}</span>
                </label>
              ))}
            </div>
            <p class="error" data-error="types" hidden>Pick at least one so we know who to send.</p>
          </fieldset>

          <fieldset class="step" data-step="2">
            <legend class="step-title"><span class="mono red">Step 2 of 4</span>Scope and timing</legend>
            <div class="radio-block">
              <p class="radio-label mono">How big is the job?</p>
              <div class="radio-row">
                {scopes.map((v, i) => <label class="pill"><input type="radio" name="scope" value={v} required={i === 0} /><span>{v}</span></label>)}
              </div>
            </div>
            <div class="radio-block">
              <p class="radio-label mono">When would you like to start?</p>
              <div class="radio-row">
                {timelines.map((v, i) => <label class="pill"><input type="radio" name="timeline" value={v} required={i === 0} /><span>{v}</span></label>)}
              </div>
            </div>
            <div class="radio-block">
              <p class="radio-label mono">Budget range <span class="opt">(optional)</span></p>
              <div class="radio-row">
                {budgets.map((v) => <label class="pill"><input type="radio" name="budget" value={v} /><span>{v}</span></label>)}
              </div>
            </div>
          </fieldset>

          <fieldset class="step" data-step="3">
            <legend class="step-title"><span class="mono red">Step 3 of 4</span>Where, and what's the idea?</legend>
            <div class="field">
              <label for="town">Town</label>
              <input id="town" name="town" class="input" list="townList" autocomplete="address-level2" placeholder="e.g. Libertyville" required />
              <datalist id="townList">{towns.map((t) => <option value={t} />)}</datalist>
            </div>
            <div class="field">
              <label for="message">Tell us about the project <span class="opt">(optional)</span></label>
              <textarea id="message" name="message" class="textarea" rows="5" placeholder="What you'd like to change, what's not working today, anything you've already picked out…"></textarea>
            </div>
          </fieldset>

          <fieldset class="step" data-step="4">
            <legend class="step-title"><span class="mono red">Step 4 of 4</span>How do we reach you?</legend>
            <div class="two">
              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" class="input" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" class="input" autocomplete="tel" required />
              </div>
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" class="input" autocomplete="email" required />
            </div>
            <div class="radio-block">
              <p class="radio-label mono">Best way to reach you</p>
              <div class="radio-row">
                {['Phone call', 'Text', 'Email'].map((v, i) => <label class="pill"><input type="radio" name="contact_pref" value={v} checked={i === 0} /><span>{v}</span></label>)}
              </div>
            </div>
            <div class="hp" aria-hidden="true">
              <label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label>
            </div>
          </fieldset>

          <div class="wizard-nav">
            <button type="button" class="btn btn-line" data-back hidden>← Back</button>
            <button type="button" class="btn" data-next>Continue <span class="arrow" aria-hidden="true">→</span></button>
            <button type="submit" class="btn btn-red" data-submit hidden>Send my request <span class="arrow" aria-hidden="true">→</span></button>
          </div>
        </form>

        <div class="done" id="done" hidden tabindex="-1">
          <span class="mono red">Request received</span>
          <h2 class="display-m">Thank you. We'll be in touch within one business day.</h2>
          <p>If your project is time-sensitive, call us at <a href={site.phoneHref}>{site.phone}</a>.</p>
          <a href="/portfolio" class="btn btn-line">Browse projects while you wait</a>
        </div>

        <div class="done" id="offline" hidden tabindex="-1">
          <span class="mono red">Almost there</span>
          <h2 class="display-m">Online requests aren't available right now.</h2>
          <p>Your answers are below. Call <a href={site.phoneHref}>{site.phone}</a> and we'll take it from there, or copy them into an email.</p>
          <pre id="summary"></pre>
          <div class="done-actions">
            <a href={site.phoneHref} class="btn btn-red">Call {site.phone}</a>
            <button type="button" class="btn btn-line" id="copySummary">Copy my answers</button>
          </div>
        </div>
      </div>

      <aside class="est-side">
        <div class="side-card bg-ink">
          <p class="mono">Prefer to talk?</p>
          <a href={site.phoneHref} class="side-phone">{site.phone}</a>
          <ul>
            {site.hours.map((h) => <li><span>{h.days}</span><span>{h.time}</span></li>)}
            <li><span>Fax</span><span>{site.fax}</span></li>
          </ul>
        </div>
        <div class="side-card">
          <h2 class="mono">What happens next</h2>
          <ol class="next">
            <li><span><b>We call you</b> within one business day to set up a visit.</span></li>
            <li><span><b>We meet at your home</b>, walk the space and talk goals and budget.</span></li>
            <li><span><b>You get a design and a proposal</b> covering 54+ categories, with a guaranteed schedule.</span></li>
          </ol>
        </div>
        <div class="side-card">
          <h2 class="mono">Payment</h2>
          <p class="pay">{site.payment.join(' · ')}</p>
          <p class="muted small">Payment plans available.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section bg-paper-2">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 class="display-m">Good to know.</h2>
      </div>
      <div class="faqs">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<span aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .est-hero h1 { max-width: 14ch; }
  .est-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .wizard, .done {
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 3px solid var(--ink);
    padding: clamp(22px, 4vw, 44px);
  }
  .progress {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 36px;
  }
  .progress li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    border-top: 3px solid var(--paper-3);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    transition: border-color 0.3s, color 0.3s;
  }
  .progress span {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .progress .is-current, .progress .is-done { color: var(--ink); border-color: var(--ink); }
  .progress .is-current { border-color: var(--red); }
  .progress .is-done span { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .step { border: 0; display: grid; gap: 22px; }
  :global(.js) .step:not(.is-active) { display: none; }
  .step-title {
    display: grid;
    gap: 8px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .step-title .mono { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.06em; }
  .hint { color: var(--muted); margin-top: -8px; }
  .opt { text-transform: none; letter-spacing: 0; opacity: 0.7; }

  .type-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr));
    gap: 10px;
  }
  .type { position: relative; cursor: pointer; }
  .type input, .pill input { position: absolute; opacity: 0; pointer-events: none; }
  .type span {
    display: flex;
    align-items: center;
    min-height: 64px;
    padding: 12px 16px 12px 44px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    font-weight: 600;
    line-height: 1.2;
    transition: border-color 0.15s, background 0.15s;
    position: relative;
  }
  .type span::before {
    content: '';
    position: absolute;
    left: 16px;
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--line-strong);
    border-radius: 2px;
    background: var(--card);
  }
  .type:hover span { border-color: var(--ink); }
  .type input:checked + span { border-color: var(--ink); background: var(--paper); box-shadow: inset 0 0 0 1px var(--ink); }
  .type input:checked + span::before { background: var(--red); border-color: var(--red); box-shadow: inset 0 0 0 3px var(--card); }
  .type input:focus-visible + span, .pill input:focus-visible + span { outline: 2px solid var(--red); outline-offset: 2px; }

  .radio-block { display: grid; gap: 12px; }
  .radio-label { font-size: 0.72rem; color: var(--muted); }
  .radio-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { position: relative; cursor: pointer; }
  .pill span {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 18px;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .pill:hover span { border-color: var(--ink); }
  .pill input:checked + span { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .hp { position: absolute; left: -9999px; }
  .error { color: var(--red-ink); font-weight: 600; }

  .wizard-nav {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .wizard-nav [data-back] { margin-right: auto; }
  .wizard.is-sending [data-submit] { opacity: 0.6; pointer-events: none; }

  .done { display: grid; gap: 16px; justify-items: start; }
  .done[hidden] { display: none; }
  .done:focus { outline: none; }
  .done p a { color: var(--red-ink); font-weight: 700; }
  .done pre {
    width: 100%;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    background: var(--paper);
    border: 1px dashed var(--line-strong);
    padding: 16px;
  }
  .done-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .est-side { display: grid; gap: 16px; position: sticky; top: calc(var(--header-h) + 24px); }
  .side-card { background: var(--card); border: 1px solid var(--line); padding: 22px; border-radius: var(--radius); }
  .side-card.bg-ink { background: var(--ink); border-color: var(--ink); }
  .side-card .mono, .side-card h2 { font-size: 0.7rem; color: var(--muted); font-family: var(--font-mono); font-weight: 500; }
  .side-card.bg-ink .mono { color: #a19b8f; }
  .side-phone {
    display: block;
    margin: 6px 0 16px;
    font-family: var(--font-display);
    font-stretch: 118%;
    font-weight: 800;
    font-size: 2rem;
    color: var(--paper);
    letter-spacing: -0.02em;
  }
  .side-phone:hover { color: var(--red); }
  .side-card ul li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    border-top: 1px solid var(--line-dark);
    font-size: 0.92rem;
  }
  .next { counter-reset: n; display: grid; gap: 14px; margin-top: 14px; }
  .next li { counter-increment: n; display: grid; grid-template-columns: 28px 1fr; font-size: 0.95rem; color: var(--muted); }
  .next li::before { content: counter(n, decimal-leading-zero); font-family: var(--font-mono); font-size: 0.72rem; color: var(--red-ink); padding-top: 3px; }
  .next b { color: var(--ink); }
  .pay { font-weight: 700; color: var(--ink); margin-top: 10px; }
  .small { font-size: 0.88rem; }

  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); }
  .faq-grid h2 { margin-top: 16px; }
  .faqs { border-top: 2px solid var(--ink); }
  details { border-bottom: 1px solid var(--line-strong); }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
  }
  summary::-webkit-details-marker { display: none; }
  summary span { font-size: 1.6rem; font-weight: 400; transition: transform 0.25s var(--ease); color: var(--red); }
  details[open] summary span { transform: rotate(45deg); }
  details p { padding: 0 0 24px; color: var(--muted); max-width: 60ch; }

  @media (max-width: 960px) {
    .est-grid, .faq-grid { grid-template-columns: 1fr; }
    .est-side { position: static; }
  }
  @media (max-width: 560px) {
    .progress li { font-size: 0; gap: 0; }
    .two { grid-template-columns: 1fr; }
    .wizard-nav .btn { flex: 1; }
  }
</style>

<script>
  const form = document.getElementById('estimate') as HTMLFormElement;
  const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.step'));
  const bars = Array.from(form.querySelectorAll<HTMLLIElement>('.progress li'));
  const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
  const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const typeErr = form.querySelector<HTMLElement>('[data-error="types"]')!;
  let current = 0;

  // Pre-select project type from ?type= (links across the site use service and category slugs).
  const alias: Record<string, string> = {
    kitchens: 'kitchen', bathrooms: 'bathroom', basements: 'basement', additions: 'addition',
    'decks-exteriors': 'outdoor', 'new-homes': 'new-home', theaters: 'theater', handyman: 'handyman',
  };
  const t = new URLSearchParams(location.search).get('type');
  if (t) {
    const key = alias[t] || t;
    const box = form.querySelector<HTMLInputElement>(`input[data-key="${key}"]`);
    if (box) box.checked = true;
  }

  const show = (i: number, focus = true) => {
    current = i;
    steps.forEach((s, j) => s.classList.toggle('is-active', j === i));
    bars.forEach((b, j) => {
      b.classList.toggle('is-current', j === i);
      b.classList.toggle('is-done', j < i);
    });
    back.hidden = i === 0;
    next.hidden = i === steps.length - 1;
    submit.hidden = i !== steps.length - 1;
    if (focus) {
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      steps[i].querySelector<HTMLElement>('input:not([type=hidden]), textarea')?.focus({ preventScroll: true });
    }
  };

  const valid = (i: number) => {
    const step = steps[i];
    if (i === 0) {
      const ok = !!step.querySelector('input[name="project_type"]:checked');
      typeErr.hidden = ok;
      return ok;
    }
    for (const el of step.querySelectorAll<HTMLInputElement>('input, textarea')) {
      if (!el.checkValidity()) { el.reportValidity(); return false; }
    }
    return true;
  };

  next.addEventListener('click', () => { if (valid(current)) show(current + 1); });
  back.addEventListener('click', () => show(current - 1));
  form.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'project_type') typeErr.hidden = true;
  });
  form.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.target as HTMLElement).tagName === 'INPUT' && current < steps.length - 1) {
      e.preventDefault();
      next.click();
    }
  });

  const summarize = (data: FormData) => {
    const lines = [
      ['Project', data.getAll('project_type').join(', ')],
      ['Scope', data.get('scope')],
      ['Timeline', data.get('timeline')],
      ['Budget', data.get('budget') || 'Not given'],
      ['Town', data.get('town')],
      ['Name', data.get('name')],
      ['Phone', data.get('phone')],
      ['Email', data.get('email')],
      ['Contact by', data.get('contact_pref')],
      ['Notes', data.get('message') || '-'],
    ];
    return lines.map(([k, v]) => `${k}: ${v}`).join('\n');
  };

  const reveal = (id: string) => {
    form.hidden = true;
    const el = document.getElementById(id)!;
    el.hidden = false;
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    el.focus({ preventScroll: true });
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!valid(current)) return;
    const data = new FormData(form);
    if (data.get('company_website')) return; // bot
    data.delete('company_website');
    data.set('project_type', data.getAll('project_type').join(', '));
    const subject = `Estimate request: ${data.get('project_type')} in ${data.get('town')}`;
    data.set('subject', subject); // Web3Forms
    data.set('_subject', subject); // Formspree
    data.set('replyto', String(data.get('email') || '')); // replies go to the customer

    const endpoint = form.dataset.endpoint;
    if (!endpoint) {
      document.getElementById('summary')!.textContent = summarize(new FormData(form));
      reveal('offline');
      return;
    }

    form.classList.add('is-sending');
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      reveal('done');
    } catch {
      document.getElementById('summary')!.textContent = summarize(new FormData(form));
      reveal('offline');
    } finally {
      form.classList.remove('is-sending');
    }
  });

  document.getElementById('copySummary')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(document.getElementById('summary')!.textContent || '');
      btn.textContent = 'Copied';
    } catch {
      btn.textContent = 'Select the text above to copy';
    }
  });

  show(0, false);
</script>

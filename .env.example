# Estimate form delivery. By default the form posts to Web3Forms using the
# access key in src/data/site.ts (web3formsKey), which emails estimates@remodzz.com.
# PUBLIC_WEB3FORMS_KEY overrides that key; PUBLIC_ESTIMATE_ENDPOINT overrides the
# endpoint entirely (anything accepting FormData with Accept: application/json).
# With neither set, the form shows visitors a "please call" fallback with their answers.
PUBLIC_WEB3FORMS_KEY=
PUBLIC_ESTIMATE_ENDPOINT=
